        creditsLabelFaces: 'Faces',
        creditsValueFaces: 'Bella Hadid, Gigi Hadid, Joan Smalls, Adut Akech, Paris Hilton, Sydney Sweeney',
        selectedHeading: 'Selected Shows',
        selectedSubheading: 'The work that carries the most weight first. The houses, rooms, and assignments that signal level without saying it out loud.',
        indexHeading: 'What matters survives the season.',
        indexCopy1: 'This is not a daily churn site. It is a body of work shaped by runway time, backstage labor, beauty instinct, and enough discipline to know when an image is doing more than documenting a dress.',
        indexCopy2: 'The names, the rooms, the conditions, the photographs, and the writing can carry the argument without leaning on biography.',
        archiveHeading: 'Archive',
        archiveSubheading: 'The wider body of work. Runway, backstage, beauty, and fashion power written from inside the room.',
        archiveToolsCopy: 'Browse the archive as an editorial index. Video pieces and galleries live together here while the front of the site stays tightly edited.',
        sortNewest: 'Newest First',
        sortRandom: 'Shuffle Archive',
        footerTagline: 'Fashion archive and selected editorial work',
        loadingFeature: 'Loading feature',
        loadingSelected: 'Loading selection',
        loadingArchive: 'Loading archive',
        heroCta: 'View story',
        articleTypeVideo: 'Film / Motion',
        articleTypeGallery: 'Runway / Gallery',
        articleTypeEditorial: 'Editorial / Notes'
      }
    };

    const SELECTED_SLUGS = [
      'tory-burch-and-shiseido-2025-01-20',
      'elie-saab-paris-autumn-winter-2019-2025-06-14',
      'sportmax-milan-autumn-winter-2019-2025-06-27',
      'the-blonds-family-2025-07-07',
      'thom-browne-ny-paris-autumn-winter-2019-2025-06-30',
      'leonard-paris-autumn-winter-2019-2025-07-07',
      'phillip-lim-3-1-nyfw-fall-2019-2025-07-08',
      'anna-sui-the-downtown-alchemist-who-never-sold-out-2025-07-07',
      'moschino-milan-spring-summer-2019-2025-06-17'
    ];

    const FOCAL_POINTS = {
      'tory-burch-and-shiseido-2025-01-20': 'center 20%',
      'thom-browne-ny-paris-autumn-winter-2019-2025-06-30': 'center 16%',
      'elie-saab-paris-autumn-winter-2019-2025-06-14': 'center 10%',
      'stella-mccartney-2025-07-06': 'center 16%',
      'moschino-milan-spring-summer-2019-2025-06-17': 'center 18%',
      'philipp-plein-milan-spring-summer-2019-2025-06-23': 'center 16%'
    };

    let archiveArticles = [];
    const currentLang = 'it';

    function getFocalPoint(article) {
      return FOCAL_POINTS[article.slug] || 'center 18%';
    }

    function textFor(key) {
      return UI_COPY[currentLang]?.[key] || UI_COPY.it[key] || '';
    }

    function getPreviewImage(article) {
      if (article.cover && article.cover.trim() !== '') {
        return article.cover;
      }
      if (article.hero_shots && article.hero_shots.length > 0 && article.hero_shots[0].url) {
        return article.hero_shots[0].url;
      }
      return "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1200 1600'%3E%3Crect fill='%23000' width='1200' height='1600'/%3E%3Ctext x='50%25' y='50%25' dominant-baseline='middle' text-anchor='middle' fill='%23f4f0ea' font-family='serif' font-size='80' font-weight='300' letter-spacing='0.08em'%3EFiamma%3C/text%3E%3C/svg%3E";
    }

    function getPreviewVideo(article) {
      if (article.videos && article.videos.length > 0) {
        return article.videos[0].url;
      }
      if (article.video && article.video.length > 0) {
        return article.video[0].url;
      }
      if (article.video_url) return article.video_url;
      return null;
    }

    function articleType(article) {
      if (article.hasVideo) return textFor('articleTypeVideo');
      if (article.template === 'gallery') return textFor('articleTypeGallery');
      return textFor('articleTypeEditorial');
    }

    function renderHero(article) {
      const feature = document.getElementById('hero-feature');
      const videoUrl = getPreviewVideo(article);
      const imageUrl = getPreviewImage(article);
      
      let backgroundHtml = '';
      if (videoUrl) {
        backgroundHtml = `
          <div class="media-container">
            <video class="full-media" autoplay muted loop playsinline poster="${imageUrl}">
              <source src="${videoUrl}" type="video/mp4">
            </video>
          </div>`;
      } else {
        backgroundHtml = `
          <div class="media-container">
            <img class="full-media" src="${imageUrl}" alt="${article.title}">
          </div>`;
      }

      feature.innerHTML = `
        ${backgroundHtml}
        <div class="hero-feature-copy">
          <div class="hero-feature-meta">${articleType(article)} • ${article.date}</div>
          <h3>${article.title}</h3>
          <p>${article.excerpt}</p>
          <a class="button" href="articles/${article.slug}/">${textFor('heroCta')}</a>
        </div>
      `;
    }

    function renderSelected(articles) {
      const grid = document.getElementById('selected-grid');
      grid.innerHTML = articles.map((article, index) => {
        const size = index < 2 ? 'large' : 'medium';
        const videoUrl = getPreviewVideo(article);
        const imageUrl = getPreviewImage(article);
        
        let mediaHtml = '';
        if (videoUrl) {
          mediaHtml = `
            <div class="media-container">
              <video class="full-media" autoplay muted loop playsinline poster="${imageUrl}">
                <source src="${videoUrl}" type="video/mp4">
              </video>
            </div>`;
        } else {
          mediaHtml = `
            <div class="media-container">
              <img class="full-media" src="${imageUrl}" alt="${article.title}" loading="lazy" decoding="async">
            </div>`;
        }

        return `
          <a href="articles/${article.slug}/" class="selected-card ${size}">
            ${mediaHtml}
            <div class="selected-copy">
              <div class="selected-meta">${articleType(article)} • ${article.date}</div>
              <div class="selected-title">${article.title}</div>
              <div class="selected-excerpt">${article.excerpt}</div>
            </div>
          </a>
        `;
      }).join('');
    }

    function renderArchive(articles) {
      const grid = document.getElementById('archive-grid');
      grid.innerHTML = articles.map((article) => {
        const videoUrl = getPreviewVideo(article);
        const imageUrl = getPreviewImage(article);
        
        let mediaHtml = '';
        if (videoUrl) {
          mediaHtml = `
            <video class="archive-video" autoplay muted loop playsinline poster="${imageUrl}">
              <source src="${videoUrl}" type="video/mp4">
            </video>
          `;
        } else {
          mediaHtml = `<img class="archive-image" src="${imageUrl}" alt="${article.title}" loading="lazy" decoding="async">`;
        }

        return `
          <a href="articles/${article.slug}/" class="archive-card">
            <div class="archive-image-wrapper">
              ${mediaHtml}
            </div>
            <div class="archive-type">${articleType(article)} • ${article.date}</div>
            <div class="archive-title">${article.title}</div>
            <div class="archive-excerpt">${article.excerpt}</div>
          </a>
        `;
      }).join('');
    }

    function shuffleArray(array) {
      const shuffled = array.slice();
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    }

    function setActiveButton(id) {
      document.querySelectorAll('.archive-button').forEach(btn => btn.classList.remove('active'));
      document.getElementById(id).classList.add('active');
    }

    fetch('articles-metadata.json')
      .then(res => res.json())
      .then((articles) => {
        const fashionArticles = articles
          .filter(article => article.categories && article.categories.includes('high-fashion-and-culture'))
          .sort((a, b) => new Date(b.date) - new Date(a.date));

        const selected = SELECTED_SLUGS
          .map(slug => fashionArticles.find(article => article.slug === slug))
          .filter(Boolean);

        const hero = selected[0] || fashionArticles[0];
        if (hero) renderHero(hero);

        if (selected.length > 0) {
          renderSelected(selected);
        } else {
          renderSelected(fashionArticles.slice(0, 5));
        }

        archiveArticles = fashionArticles.filter(article => !SELECTED_SLUGS.includes(article.slug));
        renderArchive(archiveArticles);

        document.getElementById('sort-newest').addEventListener('click', () => {
          setActiveButton('sort-newest');
          renderArchive(archiveArticles);
        });

        document.getElementById('sort-random').addEventListener('click', () => {
          setActiveButton('sort-random');
          renderArchive(shuffleArray(archiveArticles));
        });
      })
      .catch((err) => {
        console.error('Error loading Fiamma metadata:', err);
        document.getElementById('hero-feature').innerHTML = `<div class="hero-feature-copy"><div class="loading">${textFor('loadingFeature')}</div></div>`;
        document.getElementById('selected-grid').innerHTML = `<div class="loading">${textFor('loadingSelected')}</div>`;
        document.getElementById('archive-grid').innerHTML = `<div class="loading">${textFor('loadingArchive')}</div>`;
      });

  </script>
    <!-- WebMCP: AI Agent Tools -->
    <script>
      if (window.navigator && window.navigator.modelContext) {
        window.navigator.modelContext.provideContext({
          tools: [
            {
              name: "list_articles",
              description: "Returns a list of all fashion articles in the archive with their titles, slugs, and excerpts.",
              inputSchema: {
                type: "object",
                properties: {
                  limit: { type: "number", description: "Maximum number of articles to return" },
                  category: { type: "string", description: "Filter by category" }
                }
              },
              execute: async ({ limit, category }) => {
                const response = await fetch('/articles-metadata.json');
                let articles = await response.json();
                
                if (category) {
                  articles = articles.filter(a => a.categories.includes(category));
                }
                
                if (limit) {
                  articles = articles.slice(0, limit);
                }
                
                return {
                  articles: articles.map(a => ({
                    title: a.title,
                    slug: a.slug,
                    excerpt: a.excerpt,
                    date: a.date,
                    categories: a.categories
                  }))
                };
              }
            },
            {
              name: "get_article",
              description: "Returns the full content of a specific article by its slug.",
              inputSchema: {
                type: "object",
                properties: {
                  slug: { type: "string", description: "The slug of the article to retrieve" }
                },
                required: ["slug"]
              },
              execute: async ({ slug }) => {
                const response = await fetch('/articles-metadata.json');
                const articles = await response.json();
                const article = articles.find(a => a.slug === slug);
                
                if (!article) {
                  return { error: "Article not found" };
                }
                
                return { article };
              }
            },
            {
              name: "search_articles",
              description: "Search for articles matching a text query in their title or content.",
              inputSchema: {
                type: "object",
                properties: {
                  query: { type: "string", description: "Search query" }
                },
                required: ["query"]
              },
              execute: async ({ query }) => {
                const response = await fetch('/articles-metadata.json');
                const articles = await response.json();
                const q = query.toLowerCase();
                
                const results = articles.filter(a => 
                  a.title.toLowerCase().includes(q) || 
                  a.excerpt.toLowerCase().includes(q) ||
                  (a.body && a.body.toLowerCase().includes(q))
                );
                
                return {
                  results: results.slice(0, 10).map(a => ({
                    title: a.title,
                    slug: a.slug,
                    excerpt: a.excerpt
                  }))
                };
              }
            }
          ]
        });
        console.log("🚀 WebMCP Agent tools registered");
      }
    </script>
    
